<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_custom_note" model="ir.ui.view">
        <field name="name">stock.move.form.custom.note</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="x_custom_note"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_custom_note" model="ir.ui.view">
        <field name="name">stock.move.list.custom.note</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="x_custom_note"/>
            </xpath>
        </field>
    </record>

    <record id="action_stock_move_custom_note" model="ir.actions.act_window">
        <field name="name">Stock Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_move_custom_note"
              name="Stock Moves (Custom)"
              parent="stock.menu_stock_root"
              action="action_stock_move_custom_note"
              sequence="99"/>

</odoo>