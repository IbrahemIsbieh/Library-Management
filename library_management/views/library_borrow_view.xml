<odoo>
    <record id="library_borrow_list" model="ir.ui.view">
        <field name="name">library.borrow.list</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
           <list>
               <field name="book_id"/>
               <field name="member_id"/>
               <field name="borrow_date"/>
               <field name="return_date"/>
           </list>

        </field>
    </record>
<record id="library_borrow_form" model="ir.ui.view">
    <field name="name" >library.borrow.form</field>
    <field name="model" >library.borrow</field>
    <field name="arch" type="xml">
        <form>

            <sheet>
                <group>
                    <field name="book_id"/>
                    <field name="member_id"/>
                </group>
                <group>
                    <field name="borrow_date"/>
                    <field name="return_date"/>
                </group>
            </sheet>

        </form>
    </field>

</record>

<record id="library_borrow_action" model="ir.actions.act_window">
    <field name="name">library.borrow</field>
    <field name="res_model">library.borrow</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
